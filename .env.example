# Application
APP_NAME=Smart OA Agent
APP_ENV=production
APP_HTTP_PORT=8080
CORS_ORIGINS=http://localhost:8080

# MySQL (MYSQL_DATABASE is fixed because init_mysql.sql uses smart_oa)
MYSQL_DATABASE=smart_oa
MYSQL_USER=smart_oa
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Redis
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=smart_oa
SESSION_TTL_SECONDS=2592000

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# DeepSeek (obtain your own API Key; never commit the populated .env)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
